# User RGB LED D4 (RGB1) - HD PL I/O Bank 44, VCCO = 1.8V
set_property PACKAGE_PIN A7 [get_ports led_d4_r]
set_property IOSTANDARD LVCMOS18 [get_ports led_d4_r]
set_property PACKAGE_PIN B6 [get_ports led_d4_g]
set_property IOSTANDARD LVCMOS18 [get_ports led_d4_g]
set_property PACKAGE_PIN B5 [get_ports led_d4_b]
set_property IOSTANDARD LVCMOS18 [get_ports led_d4_b]

# User RGB LED D5 (RGB2) - HP PL I/O Bank 65/66, VCCO = 1.8V
set_property PACKAGE_PIN B4 [get_ports led_d5_r]
set_property IOSTANDARD LVCMOS18 [get_ports led_d5_r]
set_property PACKAGE_PIN A2 [get_ports led_d5_g]
set_property IOSTANDARD LVCMOS18 [get_ports led_d5_g]
set_property PACKAGE_PIN F4 [get_ports led_d5_b]
set_property IOSTANDARD LVCMOS18 [get_ports led_d5_b]
